# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 本地开发调试归档（截图/脚本/日志，保留不删但不上传）
/_dev-archive/

# SQLite 数据库文件
/prisma/dev.db
/prisma/*.db-journal

# 运行日志
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 用户上传文件（壁纸等，不入库）
/uploads/

# 开发助手工作区文件（本地保留，不入库）
/AGENTS.md
/CLAUDE.md
/DEV_TASK.md
/MEMORY.md
/USER.md
/SOUL.md
/IDENTITY.md
/TOOLS.md
/HEARTBEAT.md
/BOOTSTRAP.md
/memory/

# 本地临时测试文件
/.fetch/
