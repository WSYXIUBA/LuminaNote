# 肆一纸心の栖息居 — 环境变量示例
# 复制为 .env 后按需修改（.env 已被 gitignore，不会提交）

# SQLite 数据库文件（相对 prisma/ 目录）
DATABASE_URL="file:./dev.db"

# 管理员初始账号（仅首次 seed 时创建）
ADMIN_USERNAME="admin"
# 首次部署请务必改成强密码！
ADMIN_PASSWORD="admin123"

# 会话签名密钥（生产环境务必设置随机长字符串，例如 openssl rand -base64 32）
JWT_SECRET="siyizhixin-habitat-dev-secret-2026"
